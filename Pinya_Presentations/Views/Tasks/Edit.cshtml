@model TaskViewModel

<form method="post" action="/Tasks/Edit">
    <div class="d-flex flex-column gap-2">
        <div class="row">
            <div class="col-4">
                @(Html.LabelFor(x => x.Title))
            </div>
            <div class="col-8">
                @(Html.TextBoxFor(x => x.Title, new { @class = "form-control" }))
            </div>
        </div>
        <div class="row">
            <div class="col-4">
                @(Html.LabelFor(x => x.Status))
            </div>
            <div class="col-8">
                @(Html.EditorFor(x => x.Status))
            </div>
        </div>
        <div class="row">
            <div class="col-4">
                @(Html.LabelFor(x => x.Source))
            </div>
            <div class="col-8">
                @(Html.EditorFor(x => x.Source))
            </div>
        </div>
        <div class="row">
            <div class="col-4">
                @(Html.LabelFor(x => x.OrderItem))
            </div>
            <div class="col-8">
                @(Html.EditorFor(x => x.OrderItem))
            </div>
        </div>
        <div class="row">
            <div class="col-4">
                @(Html.LabelFor(x => x.PercentComplete))
            </div>
            <div class="col-8">
                @(Html.EditorFor(x => x.PercentComplete))
            </div>
        </div>
        <button class="btn btn-primary">Uložit</button>
    </div>
</form>
