@using Pinya_Presentations.Hubs
@model IEnumerable<ChatMessageViewModel>
<div style="max-width: 600px; margin: 0 auto; display: flex; flex-direction: column; gap: 5px;">
    <div class="chat-messages" style="display: flex; flex-direction: column; gap: 10px; height: 500px; overflow-y: scroll;">
        @foreach (var message in Model)
        {
            <div class="chat-row" sent-at="@(message.SentAtUtc.ToString("o"))">
                @if (message.IsMine)
                {
                    <div class="chat-box chat-box-me">
                        <p>@(message.Message)</p>
                    </div>
                }
                else
                {
                    <div class="chat-box chat-box-other">
                        <b>@(message.Username)</b>
                        <p>@(message.Message)</p>
                    </div>
                }
            </div>
        }
    </div>
    <label for="Message">Message</label>
    @Html.TextArea("Message")
    <a onclick="sendMessage()" class="btn btn-primary">Send</a>
</div>

<style>

    .chat-row {
        width: 100%;
    }

    .chat-box {
        width: fit-content;
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 5px;
    }

        .chat-box p {
            margin-bottom: 0.3rem;
        }

    .chat-box-other {
        background: #eee;
    }

    .chat-box-me {
        float: right;
        color: white;
        background: var(--bs-primary);
    }

</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/9.0.6/signalr.min.js"></script>
<script>
     const connection = new signalR.HubConnectionBuilder()
         .withUrl("/ChatHub")
         .configureLogging(signalR.LogLevel.Information)
         .build();

     connection.on("@(ChatHub.NEW_MESSAGE_EVENT)", (message) => {
         renderMessage(message);
     });

     connection.start();

    async function sendMessage() {
         const message = $("#Message").val();
         $("#Message").val('');
         const result = await connection.invoke("@(nameof(ChatHub.SendMessage))", message);
         if (result) {
             renderMyMessage(result);
         }
    }

    function renderMessage(message) {
        $(".chat-messages").append(`<div class="chat-row" sent-at="${message.sentAtUtc}"><div class="chat-box chat-box-other"><b>${message.username}</b><p>${message.message}</p></div></div>`);
    }
    function renderMyMessage(message) {
        $(".chat-messages").append(`<div class="chat-row" sent-at="${message.sentAtUtc}"><div class="chat-box chat-box-me"><p>${message.message}</p></div></div>`);
    }

</script>