@model Address
@{
    string editorId = Guid.NewGuid().ToString().Replace("-", "");
}

<hr />
<div class="row mb-2">
    <div class="col-sm-4">
        @Html.LabelFor(x => x.Country, $"{Html.DisplayNameFor(x => x)} - {Html.DisplayNameFor(x => x.Country)}")
    </div>
    <div class="col-sm-8">
        @Html.TextBoxFor(x => x.Country, new { @class = "form-control" })
    </div>
</div>
<div class="row mb-2">
    <div class="col-sm-4">
        @Html.LabelFor(x => x.City, $"{Html.DisplayNameFor(x => x)} - {Html.DisplayNameFor(x => x.City)}")
    </div>
    <div class="col-sm-8">
        @Html.TextBoxFor(x => x.City, new { @class = "form-control", onchange = $"cityChanged{editorId}(this)" })
    </div>
</div>
<div class="row mb-2">
    <div class="col-sm-4">
        @Html.LabelFor(x => x.ZipCode, $"{Html.DisplayNameFor(x => x)} - {Html.DisplayNameFor(x => x.ZipCode)}")
    </div>
    <div class="col-sm-8">
        @Html.TextBoxFor(x => x.ZipCode, new { @class = "form-control" })
    </div>
</div>
<div class="row mb-2">
    <div class="col-sm-4">
        @Html.LabelFor(x => x.Street, $"{Html.DisplayNameFor(x => x)} - {Html.DisplayNameFor(x => x.Street)}")
    </div>
    <div class="col-sm-8">
        @Html.TextBoxFor(x => x.Street, new { @class = "form-control" })
    </div>
</div>

<script>

    function cityChanged@(Html.Raw(editorId))(sender)
    {
        if ($(sender).val() !== "Brno")
            return;
        $("#@(Html.IdFor(x => x.Country))").val("ČR");
    }

</script>
