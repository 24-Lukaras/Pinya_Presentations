@using Pinya_Presentations.Domain
@model IEnumerable<Order>
@{
    var rows = Model.ToArray();
}

<a href="/Orders/Complete">Completed orders</a>
<br />

<table>
    <tr>
        <td><b>Company</b></td>
        <td><b>Items</b></td>
        <td><b>Complete</b></td>
    </tr>
    @for (int i = 0; i < rows.Length; i++)
    {
        var row = rows[i];
        <tr>
            <td>@(row.Company)</td>
            <td>@(string.Join("; ", row.Items.Select(x => $"{x.Name}: {x.Amount}")))</td>
            <td><button onclick="completeOrder('@(i == 0 ? null : row.Id)')">Complete</button></td>
        </tr>
    }
</table>

<script>

    function completeOrder(id)
    {
        $.ajax({
            type: "POST",
            url: "/Orders/Complete/" + id,
            success: () => location.reload(),
            fail: () => console.log("error")
        });
    }

</script>